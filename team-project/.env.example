# Content Strategist MVP - Configuration Template
# Source: TECHNICAL-ARCHITECTURE.md: ADR-2 (Claude 3.5 + Kimi 3 dual-model strategy)
#
# Copy to .env.local and fill in your actual API keys
# SECURITY: Never commit .env.local to git
#
# Per-Agent LLM Routing:
#   Strategist:  Kimi 3 (primary) → Claude 3.5 (fallback)
#   Creator:     Claude 3.5 (primary) → Kimi 3 (fallback)
#   Reviewer:    Kimi 3 (primary) → Claude 3.5 (fallback)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LLM CONFIGURATION (LiteLLM + Dual-Model Strategy)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Claude 3.5 Sonnet (Anthropic) - for Creator agent + fallback
ANTHROPIC_API_KEY=sk-ant-YOUR-ANTHROPIC-KEY-HERE
# Optional: Use OpenRouter for lower latency
OPENROUTER_API_KEY=sk-or-YOUR-OPENROUTER-KEY-HERE

# Kimi 3 (Moonshot) - for Strategist & Reviewer agents
KIMI_API_KEY=sk-moonshot-YOUR-KIMI-KEY-HERE

# Per-agent model selection (from TECHNICAL-ARCHITECTURE.md)
LLM_STRATEGIST_MODEL=kimi-3
LLM_STRATEGIST_FALLBACK=claude-3-5-sonnet-20241022
LLM_CREATOR_MODEL=claude-3-5-sonnet-20241022
LLM_CREATOR_FALLBACK=kimi-3
LLM_REVIEWER_MODEL=kimi-3
LLM_REVIEWER_FALLBACK=claude-3-5-sonnet-20241022

# LiteLLM settings (rate limiting, caching, timeouts)
LITELLM_TIMEOUT_SECONDS=30
LITELLM_MAX_RETRIES=3
LITELLM_RATE_LIMIT=10
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DATABASE CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Supabase (PostgreSQL)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:PASSWORD@YOUR-PROJECT.supabase.co:5432/postgres

# Pinecone (Vector database)
PINECONE_API_KEY=YOUR-PINECONE-API-KEY
PINECONE_INDEX_NAME=content-strategist-mvp
PINECONE_ENVIRONMENT=us-east-1-aws  # Check your Pinecone project

# Redis (optional cache layer)
REDIS_URL=redis://localhost:6379

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OBSERVABILITY & MONITORING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# LangSmith (Agent execution tracing)
LANGSMITH_API_KEY=YOUR-LANGSMITH-API-KEY
LANGSMITH_PROJECT=content-strategist-mvp
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Sentry (Error tracking)
SENTRY_DSN=https://YOUR-SENTRY-KEY@sentry.io/PROJECT-ID
SENTRY_ENVIRONMENT=development

# PostHog (User analytics)
POSTHOG_API_KEY=YOUR-POSTHOG-API-KEY
POSTHOG_ENDPOINT=https://us.posthog.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DEPLOYMENT & ENVIRONMENT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend deployment
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend deployment
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OPTIONAL: Cloud Deployment Credentials
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Vercel (Frontend hosting)
# VERCEL_TOKEN=YOUR-VERCEL-TOKEN
# VERCEL_PROJECT_ID=YOUR-PROJECT-ID

# Replit (Backend hosting)
# REPLIT_TOKEN=YOUR-REPLIT-TOKEN
# REPLIT_PROJECT_ID=YOUR-PROJECT-ID

# Google Cloud (for Phase 2 Cloud Run deployment)
# GCP_PROJECT_ID=YOUR-PROJECT-ID
# GCP_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# INSTRUCTIONS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Fill in the required values (marked "YOUR-"):
#    - ANTHROPIC_API_KEY: Get from https://console.anthropic.com
#    - OPENAI_API_KEY: Get from https://platform.openai.com
#    - SUPABASE_URL/KEY: Get from https://supabase.com
#    - PINECONE_API_KEY: Get from https://www.pinecone.io
#    - LANGSMITH_API_KEY: Get from https://smith.langchain.com
#    - SENTRY_DSN: Get from https://sentry.io
#    - POSTHOG_API_KEY: Get from https://posthog.com
#
# 3. Never commit .env.local to git (.gitignore already excludes it)
#
# 4. Validate configuration:
#    make validate-config
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
